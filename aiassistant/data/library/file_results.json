{
  "description": "Grid of the user's own files with image thumbnails; clicking a card opens the file. Shown automatically by search_files.",
  "data_schema": "{title?, items:[{kind:'image'|'text'|'video', name, path, snippet?, thumb? (data URI)}]}",
  "schema": {
    "type": "object",
    "required": [
      "items"
    ],
    "properties": {
      "title": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "kind",
            "name",
            "path"
          ],
          "properties": {
            "kind": {
              "enum": [
                "image",
                "text",
                "video"
              ]
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "snippet": {
              "type": "string"
            },
            "thumb": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "example": {
    "title": "Files",
    "items": [
      {
        "kind": "text",
        "name": "notes.md",
        "path": "~/Documents/notes.md",
        "snippet": "Meeting notes about the Vercel deployment overwrite and how we fixed it."
      },
      {
        "kind": "video",
        "name": "screencast.mp4",
        "path": "~/Videos/screencast.mp4"
      },
      {
        "kind": "image",
        "name": "screenshot.png",
        "path": "~/Pictures/screenshot.png"
      }
    ]
  }
}
