{
  "description": "Row of quick-reply buttons: clicking one sends that text to the assistant as the next message (follow-ups, options, confirmations).",
  "data_schema": "{title?, options:[{label, send?}]}  (send = the message to send, defaults to label)",
  "schema": {
    "type": "object",
    "required": [
      "options"
    ],
    "properties": {
      "title": {
        "type": "string"
      },
      "options": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "send": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "example": {
    "title": "What next?",
    "options": [
      {
        "label": "Tomorrow's forecast",
        "send": "what is the weather tomorrow in Jerusalem"
      },
      {
        "label": "Weekend",
        "icon": "calendar"
      }
    ]
  }
}
